# ==========================================
# NORCET Mock Test Platform - Environment Variables
# ==========================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Provide MongoDB connection URI (e.g. MongoDB Atlas or local)
# If left blank, the backend automatically uses persistent local JSON storage (zero setup needed!)
MONGODB_URI=mongodb://localhost:27017/norcet

# JWT Authentication Secret
JWT_SECRET=norcet_secret_jwt_super_secure_key_2026

# Client / Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Default Admin Credentials for Initial Seed
DEFAULT_ADMIN_EMAIL=admin@norcet.in
DEFAULT_ADMIN_PASSWORD=Admin@123
